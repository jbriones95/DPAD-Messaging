<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/toolbarBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/toolbar_padding_h"
        android:paddingEnd="@dimen/toolbar_padding_h">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/toolbar_button_width"
            android:layout_height="@dimen/toolbar_height"
            android:background="@drawable/button_focusable_bg"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="center"
            android:src="@drawable/ic_back"
            app:tint="@color/toolbar_icon_tint" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:paddingStart="@dimen/padding_small"
            android:text="@string/choose_photo"
            android:textColor="@color/toolbarText"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Photo grid -->
    <com.dpad.messaging.views.DpadRecyclerView
        android:id="@+id/rv_photos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="@dimen/padding_tiny" />

    <!-- Empty or permission message -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/padding_medium"
        android:text="@string/no_photos_found"
        android:textColor="@color/conversationSnippet"
        android:textSize="@dimen/text_size_body"
        android:visibility="gone" />

    <!-- Always available: opens the system file picker -->
    <Button
        android:id="@+id/btn_browse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_small"
        android:minHeight="40dp"
        android:text="@string/browse_files"
        android:textAllCaps="false" />

</LinearLayout>
