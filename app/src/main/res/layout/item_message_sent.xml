<?xml version="1.0" encoding="utf-8"?>
<!--
    Sent message bubble (right-aligned).
    The entire bubble is the focusable unit — focus ring appears via bubble_sent.xml selector.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingTop="@dimen/bubble_margin_v"
    android:paddingBottom="@dimen/bubble_margin_v">

    <com.dpad.messaging.views.MessageBubbleLayout
        android:id="@+id/bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/bubble_margin_h"
        android:background="@drawable/bubble_sent"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/bubble_padding_h"
        android:paddingEnd="@dimen/bubble_padding_h"
        android:paddingTop="@dimen/bubble_padding_v"
        android:paddingBottom="@dimen/bubble_padding_v">

        <com.dpad.messaging.views.MessageBodyTextView
            android:id="@+id/tv_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:focusable="false"
             android:includeFontPadding="false"
             android:scrollbars="vertical"
            android:textColor="@color/bubbleSentText"
            android:textIsSelectable="false"
             android:textSize="@dimen/text_size_body" />

        <!-- MMS image attachment(s) - RecyclerView for multiple images -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_attachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_tiny"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone" />

        <!-- Timestamp, delivery status, and encrypted transport -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:focusable="false"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:focusable="false"
                 android:includeFontPadding="false"
                 android:textColor="@color/messageMetaOnSent"
                 android:textSize="@dimen/text_size_meta" />

            <!-- Delivery status indicator -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_tiny"
                android:focusable="false"
                android:textColor="@color/messageMetaOnSent"
                 android:textSize="@dimen/text_size_meta"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_encrypted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_tiny"
                android:focusable="false"
                android:includeFontPadding="false"
                android:text="@string/dumber_encrypted"
                android:textColor="@color/messageMetaOnSent"
                android:textSize="@dimen/text_size_meta"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </com.dpad.messaging.views.MessageBubbleLayout>

    <!-- Reactions pill, overlapping the bottom edge of the bubble. Not focusable:
         reactions are read with the bubble and listed from its long-press menu. -->
    <TextView
        android:id="@+id/tv_reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/reaction_pill_inset"
        android:layout_marginTop="@dimen/reaction_pill_overlap"
        android:background="@drawable/reaction_pill_bg"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/reaction_pill_padding_h"
        android:paddingEnd="@dimen/reaction_pill_padding_h"
        android:paddingTop="@dimen/reaction_pill_padding_v"
        android:paddingBottom="@dimen/reaction_pill_padding_v"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_meta"
        android:visibility="gone" />

</LinearLayout>
